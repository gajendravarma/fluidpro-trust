  "supported_intents": {
    "ticket_count":         "Count tickets with optional filters (company, status, technician, date)",
    "ticket_summary":       "Full status breakdown for a company or all companies",
    "technician_tickets":   "Ticket count and breakdown for a specific technician, or top-10 list",
    "device_count":         "Count Pulseway-monitored devices, optionally by company",
    "device_status":        "Online/offline breakdown of Pulseway devices, optionally by company",
    "mdm_devices":          "MDM mobile device count and breakdown by type/status/company",
    "license_info":         "License expiry, total, used, remaining for a company's modules",
    "license_expiring":     "Which licenses are expiring soon (across all companies)",
    "top_companies":        "Rank companies by ticket count",
    "office365_info":       "Explain what Office 365 data is available (live API — redirects to portal)",
    "datto_info":           "Explain Datto BCDR data available (live API — redirects to portal)",
    "site24x7_info":        "Explain Site24x7 monitor data (live API — redirects to portal)",
    "help":                 "Explain what the assistant can do"
  },

