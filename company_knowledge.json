  "metadata": {
    "version": "3.0",
    "created": "2026-04-14",
    "description": "Full project knowledge base built from live DB + API structure analysis"
  },

  "data_sources": {
    "tickets": {
      "description": "ManageEngine ServiceDesk tickets — synced to local DB (TicketCache)",
      "storage": "database",
      "model": "tickets.TicketCache",
      "fields": ["ticket_id","subject","status","priority","category","requester_name","requester_email","technician_name","company_name","created_at","updated_at","resolved_at"]
    },
    "pulseway_devices": {
      "description": "Pulseway RMM monitored endpoints — synced to local DB (PulsewayDevice)",
      "storage": "database",
      "model": "pulseway.PulsewayDevice",
      "fields": ["device_id","device_name","organization_name","site_name","status","uptime","last_seen","operating_system","ip_address","cpu_usage","memory_usage","disk_usage","pending_patches"]
    },
    "mdm_devices": {
      "description": "Mobile Device Management (ManageEngine MDM) — synced to local DB",
      "storage": "database",
      "model": "mdm.Device",
      "fields": ["device_id","device_name","device_type","platform","model","manufacturer","os_version","status","enrollment_type","last_contact_time","battery_level","storage_total","storage_used","user_email","username"]
    },
    "licenses": {
      "description": "Company license records — stored in DB (CompanyLicense)",
      "storage": "database",
      "model": "rbac.CompanyLicense",
      "fields": ["company","package","total_licenses","used_licenses","expiry_date","license_type","is_active"]
    },
    "office365": {
      "description": "Microsoft 365 — live Microsoft Graph API (no full local cache)",
      "storage": "api_live",
      "note": "Returns license SKUs, user list, mailbox usage, Teams/email activity. Requires per-customer OAuth2 token."
    },
    "datto": {
      "description": "Datto BCDR — live API (no local DB)",
      "storage": "api_live",
      "note": "Returns BCDR devices, DTC assets, storage pool usage. Requires DATTO_PUBLIC_KEY/DATTO_SECRET_KEY."
    },
    "site24x7": {
      "description": "Site24x7 uptime monitoring — live API (no local DB)",
      "storage": "api_live",
      "note": "Returns monitor status per customer. Status codes: 1=Up, 0=Down, 2=Trouble, 5=Suspended, 7=Maintenance."
    }
  },

